[program:klik-laundry-worker]
process_name=%(program_name)s_%(process_num)02d
command=php /var/www/klik-laundry/artisan queue:work --sleep=3 --tries=3 --timeout=90 --max-time=3600
directory=/var/www/klik-laundry
autostart=true
autorestart=true
stopasgroup=true
killasgroup=true
stopwaitsecs=120
numprocs=2
redirect_stderr=true
stdout_logfile=/var/log/supervisor/klik-laundry-worker.log
